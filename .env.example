# Porta locale del launcher. Metti HTTPS davanti al servizio per accedere da altri dispositivi.
HUB_PORT=8080
UPDATE_INTERVAL_HOURS=12
DISCOVER_FUTURE_APPS=true
# Facoltativo: aumenta il limite delle richieste API GitHub.
GITHUB_TOKEN=
# Facoltativo: traduci automaticamente le descrizioni delle nuove app con LibreTranslate locale.
# Attiva anche il servizio con queste due righe (richiede modelli e RAM aggiuntivi):
# COMPOSE_PROFILES=translations
# TRANSLATE_URL=http://translate:5000/translate
COMPOSE_PROFILES=
TRANSLATE_URL=
TRANSLATE_API_KEY=
